# Arc Testnet Configuration
# DO NOT commit real private keys to git

# RPC endpoint for Arc Testnet
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.network

# Deployer private key (get testnet USDC from https://faucet.circle.com)
# Deployer wallet: 0xC46c1f8B4FEF6D45C6f3BCB433e928c4db4FbaE0
PRIVATE_KEY=0x_your_private_key_here

# Fee recipient (Olympus treasury - hardcoded in contract, configurable by owner)
# Production evmPlatformNativeFeeWallet
FEE_RECIPIENT=0x4d467E27F0CF402E958CC7Bb47aE258F00ABCD41

# Optional: ArcScan API key for contract verification
ARCSCAN_API_KEY=
